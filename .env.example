# Copie para .env e ajuste conforme a escola.
# DJANGO_SECRET_KEY é gerado automaticamente no 1º uso (arquivo .secret_key).

DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Se publicar em rede local:
# DJANGO_ALLOWED_HOSTS=127.0.0.1,192.168.0.10,meu-computador
DJANGO_LANG=pt-br
DJANGO_TZ=America/Sao_Paulo