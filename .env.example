# Copie para .env e ajuste conforme a escola.
# DJANGO_SECRET_KEY é gerado automaticamente no 1º uso (arquivo .secret_key).

DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Se publicar em rede local:
# DJANGO_ALLOWED_HOSTS=127.0.0.1,192.168.0.10,meu-computador
DJANGO_LANG=pt-br
DJANGO_TZ=America/Sao_Paulo

# Ative APENAS quando a plataforma for servida por HTTPS. Liga de uma vez o
# redirecionamento para HTTPS, o HSTS e os cookies de sessão/CSRF restritos a
# conexão segura. Em HTTP o navegador deixaria de enviar esses cookies e o
# login pararia de funcionar, por isso o padrão é 0.
DJANGO_SSL=0

# Publicação na internet (ver deploy/pythonanywhere/LEIA-ME.md; instalar.sh já cria este bloco):
# DJANGO_SSL=1
# DJANGO_SSL_REDIRECT=0           # a hospedagem já força HTTPS
# DJANGO_PROXY_SSL=1              # confia no X-Forwarded-Proto do proxy da hospedagem
# DJANGO_DAILY_JOBS_BACKGROUND=0  # hospedagem sem threads: rotina diária na primeira visita do dia
# DJANGO_HOSPEDAGEM=PythonAnywhere, com servidores na União Europeia
