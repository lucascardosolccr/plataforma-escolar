# Modelo de .env para produção no PythonAnywhere.
# Copie para a RAIZ do projeto como ".env" (o settings carrega automaticamente).
# NUNCA versione o .env real — ele fica no .gitignore de propósito.
# Troque SEU_USUARIO pelo seu usuário do PythonAnywhere e cole a SECRET_KEY gerada.

DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=SEU_USUARIO.pythonanywhere.com

# HTTPS: o PythonAnywhere já serve e força HTTPS, então:
DJANGO_SSL=1
DJANGO_SSL_REDIRECT=0
DJANGO_PROXY_SSL=1

# Gere uma com:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=COLE_AQUI_UMA_CHAVE_LONGA_E_ALEATORIA

# Opcionais (já têm padrão sensato no settings):
# DJANGO_TZ=America/Sao_Paulo
# DJANGO_LANG=pt-br
# DJANGO_SESSION_HOURS=8
